{
  "uid": "vibrazioni",
  "title": "Vibrazioni",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "dispositivo",
        "label": "Dispositivo",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT dispositivo FROM misure ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Classe (classificatore sulla scheda)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "normale",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "squilibrio",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "disallineamento",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "sconosciuta",
                  "color": "text",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, dispositivo AS metric, CASE classe WHEN 'normale' THEN 0 WHEN 'squilibrio' THEN 1 WHEN 'disallineamento' THEN 2 WHEN 'sconosciuta' THEN 3 END AS classe FROM misure WHERE $__timeFilter(ts) AND dispositivo IN ($dispositivo) ORDER BY ts"
        }
      ]
    },
    {
